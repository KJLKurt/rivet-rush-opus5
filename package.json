{
  "name": "rivet-rush-sky-salvage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rivet Rush: Sky Salvage — an original family-friendly 3D arcade rescue game and installable PWA.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "build:gh": "BASE_PATH=/rivet-rush-sky-salvage/ npm run build",
    "preview": "vite preview --port 4173 --host",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "playtest": "node scripts/playtest.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@types/node": "^26.5.0",
    "@types/three": "0.185.4",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
